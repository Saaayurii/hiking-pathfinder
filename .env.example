# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hikingpathfinder?schema=public"

# Mapbox (for terrain RGB data and map tiles)
MAPBOX_ACCESS_TOKEN="your_mapbox_token_here"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="your_mapbox_token_here"

# Yandex Maps API
NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your_yandex_maps_api_key_here"

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# TomTom Maps API
NEXT_PUBLIC_TOMTOM_API_KEY="your_tomtom_api_key_here"

# OpenTrailMap
NEXT_PUBLIC_OPENTRAILMAP_URL="https://tile.opentrailmap.org"

# OSM Tile Server
NEXT_PUBLIC_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
